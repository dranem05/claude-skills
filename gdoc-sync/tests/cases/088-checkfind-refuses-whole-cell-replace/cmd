R=$(bash "$GD/gdsync" init --local local.md --label t088 --mode push-only --export drive-src.md | sed -n 's/^RUN=//p')
# 1. a find that is the ENTIRE text of a cell must be refused
bash "$GD/gdsync" checkfind --run "$R" --find 'Prepare draft Review copy Ship it' >/dev/null 2>&1
echo "WHOLE_CELL_RC=$?"
# 2. a substring WITHIN that same cell must PASS -- editing inside one line is safe
bash "$GD/gdsync" checkfind --run "$R" --find 'Review copy' >/dev/null 2>&1
echo "SUBSTRING_RC=$?"
# 3. a separator row is layout, not content. ':--:' is unique here, so if the
#    guard wrongly treated it as a cell this would be 4 rather than 0.
bash "$GD/gdsync" checkfind --run "$R" --find ':--:' >/dev/null 2>&1
echo "SEPARATOR_RC=$?"
# 4. prose that is not a table cell at all must PASS
bash "$GD/gdsync" checkfind --run "$R" --find 'Some prose line here.' >/dev/null 2>&1
echo "PROSE_RC=$?"
bash "$GD/gdsync" checkfind --run "$R" --find 'Prepare draft Review copy Ship it' 2>&1 | grep -o 'TRIP: [a-z-]*'
