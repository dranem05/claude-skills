SK="$GD/../SKILL.md"
real=$(bash "$GD/gdsync" --list | sort)
used=$(grep -oE 'gdsync" (init|adopt|diff|swap|checkfind|cleanup|selftest|[a-z]+)' "$SK" \
       | sed -E 's/.*gdsync" //' | sort -u)
missing=""
for u in $used; do printf '%s\n' "$real" | grep -qx "$u" || missing="$missing $u"; done
echo "USED=$(echo $used | tr '\n' ' ')"
[ -z "$missing" ] || { echo "NOT_A_SUBCOMMAND:$missing"; exit 1; }
echo SUBCOMMANDS_MATCH
