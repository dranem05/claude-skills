# file	sed -E expression	(each must turn the suite RED)
gdsync	s/\[ "\$PL" -ge 40 \]/[ "$PL" -ge 999 ]/
gdsync	s/ns != 1 or ne != 1/False/
gdsync	s/printf "%s\\t%s\\n", anchor, target/printf "%s\n", target/
gdsync	s/exit "\$E_CONFIRM"/exit 0/
gdsync	s/request access\|you need access/ZZZNOMATCH/
gdsync	s/E_CONFIRM=4/E_CONFIRM=0/
gdsync	s/local\[ml.end\(\):\]/local[ml.end()+len(end):]/
gdsync	s/n = raw if raw else deesc/n = raw/
gdsync	s/pull-only\|two-way\)/pull-only)/
gdsync	s/\[ -s "\$side" \]/[ -e "$side" ]/
gdsync	s/\[ "\$PL" -ge 15 \]/[ "$PL" -ge 1 ]/
gdsync	s/if ns == 0 or ne == 0:/if False:/
gdsync	s/rm -f "\$RUN"\/drive.md/rm -f \/dev\/null_x/
gdsync	s/\[ "\$eabs" != "\$abs" \]/[ 1 = 1 ]/
gdsync	s/record_verdict "\$rc"/printf "%s\\n" "$rc" > "$RUN\/verdict.rc"/
gdsync	s/\[ "\$L" -lt 10 \]/[ "$L" -lt 0 ]/
gdsync	s/os.replace\(tmp, lp\)/open(lp,"w",encoding="utf-8").write(out)/
gdsync	s/-e .s\/\^\[\[:space:\]\]\*\(>\[\[:space:\]\]\*\)\+\/\/. \\//
gdsync	s/\[ "\$PL" -ge 15 \]/[ "$PL" -ge 95 ]/
gdsync	s/if .|. in find:/if False:/
gdsync	s/if _re.search/if False and _re.search/
gdsync	s/if _needle_forms & _cell_forms:/if False:/
gdsync	s/if _cells and all\(_re.fullmatch/if False and all(_re.fullmatch/
gdsync	s/\{c\.replace\('\\\\', ''\) for c in _cells\}/set()/
